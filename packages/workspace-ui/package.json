{
  "name": "@openlia/workspace-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "bun scripts/dev-real.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "screenshots": "playwright test e2e/mock-screenshots.spec.ts",
    "screenshots:headed": "playwright test e2e/mock-screenshots.spec.ts --headed",
    "screenshots:real": "WORKSPACE_UI_E2E_MODE=real playwright test e2e/real-workspace.spec.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:server": "bun test src/server",
    "typecheck": "bun run typecheck:server && bun run typecheck:client && bun run typecheck:scripts && bun run typecheck:e2e",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build": "bun run build:client && bun run build:server",
    "build:verified": "bun run typecheck && bun run build",
    "build:client": "vite build",
    "build:server": "bun build src/server/main.ts --target=bun --format=esm --outfile=dist/server.js",
    "preview": "bun run build && bun scripts/preview.ts",
    "format:check": "biome format src scripts e2e package.json tsconfig*.json *.config.ts",
    "lint": "biome lint src scripts e2e package.json tsconfig*.json *.config.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "prismjs": "^1.30.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.3.14",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "daisyui": "5",
    "happy-dom": "18.0.1",
    "tailwindcss": "4",
    "typescript": "5.9.3",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
