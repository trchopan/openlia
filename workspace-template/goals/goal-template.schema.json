{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:goal",
  "title": "Goal template frontmatter schema",
  "type": "object",
  "properties": {
    "status": {
      "type": ["string", "null"],
      "enum": [null, "active", "paused", "completed", "abandoned"]
    },
    "target_completion": {
      "type": ["string", "null"],
      "format": "date"
    },
    "review_rhythm": {
      "type": ["string", "null"],
      "enum": [null, "weekly", "monthly", "quarterly"]
    }
  },
  "required": ["status", "target_completion", "review_rhythm"],
  "additionalProperties": false
}
