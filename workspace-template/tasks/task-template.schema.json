{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:task",
  "title": "Task template frontmatter schema",
  "type": "object",
  "properties": {
    "status": {
      "type": ["string", "null"],
      "enum": [null, "todo", "in-progress", "waiting", "done", "cancelled"]
    },
    "priority": {
      "type": ["string", "null"],
      "enum": [null, "high", "medium", "low"]
    },
    "due_date": {"type": ["string", "null"], "format": "date"},
    "linked_project": {"type": ["string", "null"], "minLength": 1},
    "linked_area": {"type": ["string", "null"], "minLength": 1},
    "context_tags": {
      "type": "array",
      "items": {"enum": ["#computer", "#phone", "#errand", "#home", "#work"]},
      "uniqueItems": true
    },
    "completed_at": {"type": ["string", "null"], "format": "date"}
  },
  "required": [
    "status",
    "priority",
    "due_date",
    "linked_project",
    "linked_area",
    "context_tags",
    "completed_at"
  ],
  "additionalProperties": false
}
