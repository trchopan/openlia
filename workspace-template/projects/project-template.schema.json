{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:project",
  "title": "Project template frontmatter schema",
  "type": "object",
  "properties": {
    "status": {
      "type": ["string", "null"],
      "enum": [null, "active", "paused", "completed", "archived"]
    },
    "target_completion": {
      "type": ["string", "null"],
      "format": "date"
    },
    "linked_goal": {"type": ["string", "null"], "minLength": 1},
    "linked_area": {"type": ["string", "null"], "minLength": 1}
  },
  "required": ["status", "target_completion", "linked_goal", "linked_area"],
  "additionalProperties": false
}
