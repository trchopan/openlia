{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:assistant-policy",
  "title": "Personal Assistant delegation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "delegation", "scheduled_work", "audit"],
  "properties": {
    "$schema": {"const": "./assistant-policy.schema.json"},
    "version": {"const": 1},
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "memory", "external", "destructive"],
      "properties": {
        "workspace": {"$ref": "#/$defs/workspaceDelegation"},
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direct_reports", "observations", "inferences"],
          "properties": {
            "direct_reports": {"enum": ["record", "candidate", "ask"]},
            "observations": {"enum": ["record", "candidate", "ask"]},
            "inferences": {"enum": ["record", "candidate", "ask"]}
          }
        },
        "external": {"$ref": "#/$defs/actionDecisions"},
        "destructive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delete_records", "overwrite_records"],
          "properties": {
            "delete_records": {"enum": ["ask", "deny"]},
            "overwrite_records": {"enum": ["ask", "deny"]}
          }
        }
      }
    },
    "scheduled_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowed_actions", "report_destination"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowed_actions": {"$ref": "#/$defs/actionList"},
        "report_destination": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_authority", "preserve_source"],
      "properties": {
        "report_authority": {"type": "boolean"},
        "preserve_source": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "action": {
      "enum": [
        "capture",
        "classify",
        "create_records",
        "update_records",
        "archive_records",
        "generate_reports",
        "local_git_commits",
        "record_financial_data"
      ]
    },
    "actionList": {
      "type": "array",
      "items": {"$ref": "#/$defs/action"},
      "uniqueItems": true
    },
    "workspaceDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "allowed_actions", "allowed_domains"],
      "properties": {
        "enabled": {"type": "boolean"},
        "allowed_actions": {"$ref": "#/$defs/actionList"},
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },
    "actionDecisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "send_messages",
        "modify_external_calendar",
        "purchases",
        "financial_transactions"
      ],
      "properties": {
        "send_messages": {"enum": ["ask", "allow", "deny"]},
        "modify_external_calendar": {"enum": ["ask", "allow", "deny"]},
        "purchases": {"enum": ["ask", "allow", "deny"]},
        "financial_transactions": {"enum": ["ask", "allow", "deny"]}
      }
    }
  }
}
