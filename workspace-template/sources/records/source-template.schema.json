{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "title", "status", "captured_at", "sensitivity", "origin", "versions", "password_profile"],
  "properties": {
    "id": {"type": ["string", "null"], "pattern": "^src_[A-Za-z0-9_-]+$"},
    "kind": {"type": ["string", "null"], "enum": ["chat", "text", "file", "pdf", "image", "excel", "csv", "youtube", "other", null]},
    "title": {"type": ["string", "null"]},
    "status": {"type": ["string", "null"], "enum": ["captured", "processing", "complete", "partial", "failed", "archived", null]},
    "captured_at": {"type": ["string", "null"], "format": "date-time"},
    "sensitivity": {"type": ["string", "null"]},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "source_url", "provider", "provider_item_id", "message_id"],
      "properties": {
        "channel": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "provider": {"type": ["string", "null"]},
        "provider_item_id": {"type": ["string", "null"]},
        "message_id": {"type": ["string", "null"]}
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "original_artifact_id", "content_sha256", "media_type", "original_ref", "received_at", "retained", "extractions"],
        "properties": {
          "id": {"type": "string", "pattern": "^ver_[A-Za-z0-9_-]+$"},
          "original_artifact_id": {"type": ["string", "null"], "pattern": "^art_[A-Za-z0-9_-]+$"},
          "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "media_type": {"type": "string"},
          "original_ref": {"type": "string"},
          "received_at": {"type": "string", "format": "date-time"},
          "retained": {"type": "boolean"},
          "extractions": {"type": "array", "items": {"type": "string", "pattern": "^ext_[A-Za-z0-9_-]+$"}}
        }
      }
    },
    "password_profile": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
  }
}
