{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openlia:workspace-template:claim",
  "title": "Claim frontmatter schema",
  "$defs": {
    "dateOrDateTime": {
      "anyOf": [
        { "type": "string", "format": "date" },
        { "type": "string", "format": "date-time" }
      ]
    },
    "nullableDateOrDateTime": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/dateOrDateTime" }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    }
  },
  "type": "object",
  "properties": {
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "kind": {
      "enum": ["reported", "observed", "inferred", "hypothesis", "hypothetical"]
    },
    "status": {
      "enum": ["candidate", "active", "stale", "contested", "superseded", "retracted", "rejected"]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "ref": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["type", "ref"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "derived_from": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "required": ["evidence_refs", "derived_from"],
      "additionalProperties": false
    },
    "asserted_at": { "$ref": "#/$defs/nullableDateOrDateTime" },
    "observed_at": { "$ref": "#/$defs/nullableDateOrDateTime" },
    "valid_from": { "$ref": "#/$defs/nullableDateOrDateTime" },
    "valid_until": { "$ref": "#/$defs/nullableDateOrDateTime" },
    "review_after": { "$ref": "#/$defs/nullableDateOrDateTime" },
    "confidence": {
      "anyOf": [
        { "type": "null" },
        { "enum": ["low", "medium", "high"] },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ]
    },
    "confidence_basis": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonEmptyString" }
      ]
    },
    "reviewed_at": { "$ref": "#/$defs/nullableDateOrDateTime" },
    "reviewed_by": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonEmptyString" }
      ]
    },
    "supersedes": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/nonEmptyString" }
      ]
    }
  },
  "required": ["id", "kind", "status", "source", "provenance"],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "required": ["asserted_at"],
          "properties": { "asserted_at": { "$ref": "#/$defs/dateOrDateTime" }
          }
        },
        {
          "required": ["observed_at"],
          "properties": { "observed_at": { "$ref": "#/$defs/dateOrDateTime" }
          }
        }
      ]
    },
    {
      "if": {
        "required": ["confidence"],
        "properties": { "confidence": { "not": { "type": "null" } } }
      },
      "then": {
        "required": ["confidence_basis"],
        "properties": { "confidence_basis": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    {
      "if": {
        "required": ["kind"],
        "properties": {
          "kind": { "enum": ["inferred", "hypothesis", "hypothetical"] }
        }
      },
      "then": {
        "required": ["confidence", "confidence_basis"],
        "properties": {
          "confidence": {
            "anyOf": [
              { "enum": ["low", "medium", "high"] },
              { "type": "number", "minimum": 0, "maximum": 1 }
            ]
          },
          "confidence_basis": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    {
      "if": {
        "required": ["kind", "status"],
        "properties": {
          "kind": { "enum": ["inferred", "hypothesis", "hypothetical"] },
          "status": { "const": "active" }
        }
      },
      "then": {
        "required": ["reviewed_at", "reviewed_by"],
        "properties": {
          "reviewed_at": { "$ref": "#/$defs/dateOrDateTime" },
          "reviewed_by": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    }
  ]
}
