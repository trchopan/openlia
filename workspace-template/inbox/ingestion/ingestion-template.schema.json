{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intake_id", "source_id", "version_id", "captured_at", "kind", "operation", "requested_outputs", "status", "job_id", "continuation", "authorization", "artifact_refs", "extraction_refs", "candidate_ids", "record_refs", "retry_count", "last_error", "unresolved_questions", "callback"],
  "properties": {
    "intake_id": {"type": ["string", "null"], "pattern": "^intake_[A-Za-z0-9_-]+$"},
    "source_id": {"type": ["string", "null"], "pattern": "^src_[A-Za-z0-9_-]+$"},
    "version_id": {"type": ["string", "null"], "pattern": "^ver_[A-Za-z0-9_-]+$"},
    "captured_at": {"type": ["string", "null"], "format": "date-time"},
    "kind": {"type": ["string", "null"]},
    "operation": {"type": ["string", "null"]},
    "requested_outputs": {"type": "array", "items": {"type": "string"}},
    "status": {"type": ["string", "null"], "enum": ["captured", "queued", "processing", "awaiting-unlock", "waiting-for-password", "pending-review", "complete", "partial", "failed", "archived", null]},
    "job_id": {"type": ["string", "null"], "pattern": "^job_[A-Za-z0-9_-]+$"},
    "continuation": {"type": "object", "additionalProperties": false, "required": ["next_action", "conversation_ref", "request_ref"], "properties": {"next_action": {"type": ["string", "null"]}, "conversation_ref": {"type": ["string", "null"]}, "request_ref": {"type": ["string", "null"]}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["scope", "source"], "properties": {"scope": {"type": ["string", "null"]}, "source": {"type": ["string", "null"]}}},
    "artifact_refs": {"type": "array", "items": {"type": "string", "pattern": "^art_[A-Za-z0-9_-]+$"}},
    "extraction_refs": {"type": "array", "items": {"type": "string", "pattern": "^ext_[A-Za-z0-9_-]+$"}},
    "candidate_ids": {"type": "array", "items": {"type": "string"}},
    "record_refs": {"type": "array", "items": {"type": "string"}},
    "retry_count": {"type": "integer", "minimum": 0},
    "last_error": {"type": ["string", "null"]},
    "unresolved_questions": {"type": "array", "items": {"type": "string"}},
    "callback": {"type": "object", "additionalProperties": false, "required": ["event_id", "delivery_status"], "properties": {"event_id": {"type": ["string", "null"], "pattern": "^evt_[A-Za-z0-9_-]+$"}, "delivery_status": {"type": ["string", "null"]}}}
  }
}
