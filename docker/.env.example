# Non-secret Compose inputs. Runtime credentials belong in the configured
# mode-0600 secret source and must not be added here.
OPENLIA_DATA_ROOT=/srv/openlia/runtime/hermes
OPENLIA_SYSTEM_SKILLS_ROOT=/srv/openlia/runtime/system-skills
OPENLIA_SKILLS_CACHE_ROOT=/srv/openlia/runtime/skill-cache
OPENLIA_SKILLS_ENV_ROOT=/srv/openlia/runtime/skill-envs
OPENLIA_META_ROOT=/srv/openlia/runtime/meta
OPENLIA_BACKUP_ROOT=/srv/openlia/runtime/backups
OPENLIA_RUNTIME_UID=10000
OPENLIA_RUNTIME_GID=10000
OPENLIA_OPERATION_LOCK=/srv/openlia.operation.lock
OPENLIA_BACKUP_KNOWN_HOSTS_SOURCE=/home/openlia/.ssh/known_hosts
OPENLIA_SECRET_FILE=/srv/openlia/runtime/secrets/hermes.env
OPENLIA_SECRET_DIR=/srv/openlia/runtime/secrets
OPENLIA_NETWORK_NAME=openlia-private
OPENLIA_PROVIDER=copilot
OPENLIA_MODEL=gpt-5.6-luna
HERMES_TIMEZONE=Asia/Ho_Chi_Minh
OPENLIA_HERMES_IMAGE=openlia-hermes:v2026.9.14
OPENLIA_BACKUP_SCHEDULER_IMAGE=openlia-backup-scheduler:v2026.9.14
OPENLIA_LOCHO_IMAGE=openlia-locho:v1.2.0
HERMES_BASE_IMAGE=nousresearch/hermes-agent
HERMES_BASE_TAG=v2026.9.14
HERMES_BASE_DIGEST=sha256:99641e57ec762c59e54cb44aa6746b7fc68c18b3c5ddb088af54234c613d9294
